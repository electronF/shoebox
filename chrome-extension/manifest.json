{
  "manifest_version": 3,
  "name": "Shoebox",
  "version": "1.0.0",
  "description": "Freelance finance dashboard — quick overview of your KPIs and action items.",

  "permissions": ["tabs"],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://localhost:8050/*"
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "Shoebox — Vue d'ensemble",
    "default_icon": {
      "16":  "icons/icon16.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },

  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
