# Database — SQLite by default, swap for PostgreSQL without changing any code
DATABASE_URL=sqlite:///./data/shoebox.db
# DATABASE_URL=postgresql://user:password@localhost:5432/shoebox

# File storage
UPLOAD_DIR=./data/uploads

# Set to true to enable SQL query logging and debug endpoints
DEBUG=false

# Set to true when running the test suite (disables lifespan migrations)
TESTING=false

# API metadata
APP_TITLE=Shoebox API
APP_VERSION=0.1.0